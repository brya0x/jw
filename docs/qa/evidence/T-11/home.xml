t="" resource-id="" class="android.view.View" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,505][1080,578]" /><node index="2" text="" resource-id="" class="android.view.View" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,578][1080,1941]"><node index="0" text="" resource-id="" class="android.view.View" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,578][1080,1941]"><node index="0" text='Marmalade had claimed the windowsill the day the Okafor family moved in, and no one had ever convinced her to leave it.&#10;&#10;Every morning she watched the street: the mail carrier, the boy on the bike, the old man who walked a dog too small to matter. She kept her own schedule and answered to no one, though she did come when the tin of sardines was opened.&#10;&#10;When the rain started, the house grew quiet. Ada, the youngest, sat beside the cat and pressed her forehead against the cold glass. "Do you miss him?" she whispered. Her father had been gone three months, and nobody had said the word "moving" in weeks.&#10;&#10;Marmalade blinked slowly, then stepped onto Ada&apos;s lap and settled in with a deep, rumbling purr. It wasn&apos;t an answer, but it was warm, and it stayed.&#10;&#10;That night, Ada slept curled on the sofa with the cat rising and falling against her chest. In the morning, the rain had stopped, and the windowsill was empty. Marmalade had gone out to see the street, the way she always did.&#10;&#10;She came back before lunch, damp and unbothered, and climbed onto the sill as if she had never left.' resource-id="" class="android.widget.TextView" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[36,578][1044,901]" /><node index="1" text="also say done" resource-id="" class="android.widget.TextView" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[187,955][1014,1007]" /><node index="2" text="✻ pensó 1 s" resource-id="" class="android.widget.TextView" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[36,1061][249,1103]" /><node index="3" text="Done." resource-id="" class="android.widget.TextView" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[36,1133][136,1185]" /><node index="4" text="run sleep 15 then reply ok" resource-id="" class="android.widget.TextView" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[187,1239][1014,1291]" /><node index="5" text="" resource-id="" class="android.view.View" package="dev.jw.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[36,1336][