# `just ci` for next/. Green before every commit.
default: ci

ci: fmt-check clippy test android

fmt-check:
    cargo fmt --all --check

clippy:
    cargo clippy --workspace --all-targets --locked -- -D warnings

test:
    cargo test --workspace --locked

# The Kotlin side of the contract: the same fixtures, parsed and re-written by Kotlin.
android:
    cd android && ./gradlew --no-daemon :contract:test
