{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.jwn.invalid/contract.schema.json",
  "title": "jwn contract",
  "description": "Every document the daemon and a client exchange. Entry points: ClientMsg, DaemonMsg. Unknown properties are allowed everywhere on purpose (additive changes never break an old peer).",
  "$defs": {
    "Id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "Rev": { "type": "integer", "minimum": 0 },
    "Peer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "ErrorCode": { "enum": ["bad_request", "not_found", "unsupported", "conflict", "git_failed", "io"] },
    "AttentionKind": {
      "enum": ["question", "plan", "permission", "shell_done", "agent_done", "screen", "merged", "ci_failed"]
    },
    "NodeType": { "enum": ["session", "workspace", "pane", "blocks", "diff", "commits"] },
    "BlocksMode": { "enum": ["blocks", "full"] },
    "Color": {
      "description": "A palette index (0 to 255) or a #rrggbb string.",
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
      ]
    },
    "Span": {
      "type": "object",
      "required": ["t"],
      "properties": {
        "t": { "type": "string" },
        "fg": { "$ref": "#/$defs/Color" },
        "bg": { "$ref": "#/$defs/Color" },
        "b": { "const": true },
        "i": { "const": true },
        "u": { "const": true }
      }
    },
    "Block": {
      "type": "object",
      "required": ["id", "cmd", "cwd", "started", "running", "out"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "cmd": { "type": "string" },
        "cwd": { "type": "string" },
        "started": { "type": "integer", "minimum": 0 },
        "running": { "type": "boolean" },
        "code": { "type": "integer" },
        "ms": { "type": "integer", "minimum": 0 },
        "truncated": { "const": true },
        "full": { "const": true },
        "interrupted": { "const": true },
        "restart": { "const": true },
        "out": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/Span" } } }
      }
    },
    "AgentEvent": { "description": "The hooks of an agent the daemon listens to.", "enum": ["notification", "pre_tool_use", "post_tool_use", "user_prompt_submit", "stop", "session_end"] },
    "Sha": { "type": "string", "pattern": "^[0-9a-f]{4,40}$" },
    "DiffScope": { "description": "What a diff compares: the working tree with HEAD, this branch with its merge base with origin's default branch, or one commit with its first parent.", "enum": ["uncommitted", "general", "commit"] },
    "DiffState": { "description": "no_base: origin has no default branch, so a general diff has nothing to compare with.", "enum": ["ok", "no_base"] },
    "FileStatus": { "enum": ["added", "modified", "deleted", "renamed", "untracked"] },
    "Seen": { "description": "yes: looked at and unchanged since; changed: looked at, but the file differs now.", "enum": ["yes", "changed"] },
    "Hunk": {
      "type": "object",
      "required": ["context", "old_start", "old_lines", "new_start", "new_lines", "lines"],
      "properties": {
        "context": { "type": "string", "description": "The text git prints after the second @@ (usually the enclosing function)." },
        "old_start": { "type": "integer", "minimum": 0 },
        "old_lines": { "type": "integer", "minimum": 0 },
        "new_start": { "type": "integer", "minimum": 0 },
        "new_lines": { "type": "integer", "minimum": 0 },
        "lines": { "type": "array", "items": { "type": "string", "pattern": "^[-+ ]" }, "description": "Each line prefixed with + (added), - (deleted) or a space (unchanged)." }
      }
    },
    "DiffFile": {
      "type": "object",
      "required": ["path", "status", "added", "deleted", "hash", "hunks"],
      "properties": {
        "path": { "type": "string" },
        "old_path": { "type": "string" },
        "status": { "$ref": "#/$defs/FileStatus" },
        "binary": { "const": true },
        "unreadable": { "type": "string", "minLength": 1, "description": "Why the daemon did not read the file: symlink, too_big." },
        "added": { "type": "integer", "minimum": 0 },
        "deleted": { "type": "integer", "minimum": 0 },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "seen": { "$ref": "#/$defs/Seen" },
        "hunks": { "type": "array", "items": { "$ref": "#/$defs/Hunk" } }
      }
    },
    "CommitInfo": {
      "type": "object",
      "required": ["sha", "short", "subject", "time"],
      "properties": {
        "sha": { "$ref": "#/$defs/Sha" },
        "short": { "$ref": "#/$defs/Sha" },
        "subject": { "type": "string" },
        "time": { "type": "integer", "minimum": 0, "description": "Commit time in Unix seconds." }
      }
    },
    "WorkspaceKind": { "enum": ["worktree", "folder"] },
    "Attention": {
      "type": "object",
      "required": ["kind", "node", "rev"],
      "properties": {
        "kind": { "$ref": "#/$defs/AttentionKind" },
        "node": { "$ref": "#/$defs/Id" },
        "rev": { "$ref": "#/$defs/Rev" },
        "exit_code": { "type": "integer" }
      }
    },
    "Head": {
      "type": "object",
      "required": ["id", "type", "v", "epoch", "rev", "attention"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "$ref": "#/$defs/NodeType" },
        "v": { "type": "integer", "minimum": 1 },
        "epoch": { "$ref": "#/$defs/Id" },
        "rev": { "$ref": "#/$defs/Rev" },
        "attention": { "type": "array", "items": { "$ref": "#/$defs/Attention" } }
      }
    },
    "WorkspaceSummary": {
      "type": "object",
      "required": ["id", "name", "kind", "path", "pane_count", "attention"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/WorkspaceKind" },
        "path": { "type": "string" },
        "project": { "type": "string" },
        "branch": { "type": "string" },
        "pane_count": { "type": "integer", "minimum": 0 },
        "attention": { "type": "array", "items": { "$ref": "#/$defs/Attention" } }
      }
    },
    "SplitDir": { "enum": ["row", "col"] },
    "Layout": {
      "oneOf": [
        { "type": "object", "required": ["t", "pane"], "properties": { "t": { "const": "pane" }, "pane": { "$ref": "#/$defs/Id" } } },
        {
          "type": "object",
          "required": ["t", "dir", "ratio", "a", "b"],
          "properties": {
            "t": { "const": "split" },
            "dir": { "$ref": "#/$defs/SplitDir" },
            "ratio": { "type": "integer", "minimum": 100, "maximum": 900 },
            "a": { "$ref": "#/$defs/Layout" },
            "b": { "$ref": "#/$defs/Layout" }
          }
        }
      ]
    },
    "PaneSummary": {
      "type": "object",
      "required": ["id", "title", "attention"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "title": { "type": "string" },
        "attention": { "type": "array", "items": { "$ref": "#/$defs/Attention" } }
      }
    },
    "Program": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "exit_code": { "type": "integer" }
      }
    },
    "PaneInput": {
      "type": "object",
      "required": ["text", "cursor"],
      "properties": {
        "text": { "type": "string" },
        "cursor": { "type": "integer", "minimum": 0 }
      }
    },
    "Screen": {
      "type": "object",
      "required": ["rows", "cols", "lines", "cursor"],
      "properties": {
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "lines": { "type": "array", "items": { "type": "string" } },
        "alt": { "type": "boolean" },
        "cursor": {
          "type": "object",
          "required": ["row", "col", "visible"],
          "properties": {
            "row": { "type": "integer", "minimum": 0 },
            "col": { "type": "integer", "minimum": 0 },
            "visible": { "type": "boolean" }
          }
        }
      }
    },
    "Node": {
      "oneOf": [
        {
          "allOf": [{ "$ref": "#/$defs/Head" }],
          "required": ["name", "workspaces"],
          "properties": {
            "type": { "const": "session" },
            "name": { "type": "string" },
            "workspaces": { "type": "array", "items": { "$ref": "#/$defs/WorkspaceSummary" } }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/Head" }],
          "required": ["name", "kind", "path", "panes"],
          "properties": {
            "type": { "const": "workspace" },
            "name": { "type": "string" },
            "kind": { "$ref": "#/$defs/WorkspaceKind" },
            "path": { "type": "string" },
            "project": { "type": "string" },
            "branch": { "type": "string" },
            "panes": { "type": "array", "items": { "$ref": "#/$defs/PaneSummary" } },
            "layout": { "$ref": "#/$defs/Layout" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/Head" }],
          "required": ["workspace", "title", "shell", "cwd", "screen"],
          "properties": {
            "type": { "const": "pane" },
            "workspace": { "$ref": "#/$defs/Id" },
            "title": { "type": "string" },
            "shell": { "type": "string" },
            "cwd": { "type": "string" },
            "running": { "$ref": "#/$defs/Program" },
            "last_program": { "$ref": "#/$defs/Program" },
            "screen": { "$ref": "#/$defs/Screen" },
            "blocks": { "$ref": "#/$defs/Id" },
            "input": { "$ref": "#/$defs/PaneInput" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/Head" }],
          "required": ["pane", "mode", "blocks"],
          "properties": {
            "type": { "const": "blocks" },
            "pane": { "$ref": "#/$defs/Id" },
            "mode": { "$ref": "#/$defs/BlocksMode" },
            "blocks": { "type": "array", "items": { "$ref": "#/$defs/Block" } }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/Head" }],
          "required": ["workspace", "scope", "state", "files"],
          "properties": {
            "type": { "const": "diff" },
            "workspace": { "$ref": "#/$defs/Id" },
            "scope": { "$ref": "#/$defs/DiffScope" },
            "commit": { "$ref": "#/$defs/Sha" },
            "base": { "type": "string", "description": "What general compares with, such as origin/main." },
            "state": { "$ref": "#/$defs/DiffState" },
            "too_large": { "const": true },
            "omitted": { "type": "integer", "minimum": 1, "description": "Files left out of a too large diff." },
            "files": { "type": "array", "items": { "$ref": "#/$defs/DiffFile" } }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/Head" }],
          "required": ["workspace", "commits"],
          "properties": {
            "type": { "const": "commits" },
            "workspace": { "$ref": "#/$defs/Id" },
            "base": { "type": "string" },
            "more": { "const": true },
            "commits": { "type": "array", "items": { "$ref": "#/$defs/CommitInfo" } }
          }
        }
      ]
    },
    "PatchOp": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "properties": { "op": { "const": "add" }, "path": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["op", "path"],
          "properties": { "op": { "const": "remove" }, "path": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "properties": { "op": { "const": "replace" }, "path": { "type": "string" } }
        }
      ]
    },
    "Cmd": {
      "oneOf": [
        { "type": "object", "required": ["cmd", "name"], "properties": { "cmd": { "const": "rename_session" }, "name": { "type": "string", "minLength": 1 } } },
        { "type": "object", "required": ["cmd", "path"], "properties": { "cmd": { "const": "open_folder" }, "path": { "type": "string" } } },
        { "type": "object", "required": ["cmd"], "properties": { "cmd": { "const": "list_dir" }, "path": { "type": "string" }, "hidden": { "type": "boolean" } } },
        { "type": "object", "required": ["cmd", "repo", "branch"], "properties": { "cmd": { "const": "create_worktree" }, "repo": { "type": "string" }, "branch": { "type": "string", "minLength": 1 }, "base": { "type": "string" }, "folder": { "type": "string", "minLength": 1, "maxLength": 80 } } },
        { "type": "object", "required": ["cmd", "workspace"], "properties": { "cmd": { "const": "remove_workspace" }, "workspace": { "$ref": "#/$defs/Id" }, "remove_worktree": { "type": "boolean" }, "force": { "type": "boolean" } } },
        { "type": "object", "required": ["cmd", "repo"], "properties": { "cmd": { "const": "project_config" }, "repo": { "type": "string" } } },
        { "type": "object", "required": ["cmd", "workspace"], "properties": { "cmd": { "const": "start_workspace" }, "workspace": { "$ref": "#/$defs/Id" } } },
        { "type": "object", "required": ["cmd", "workspace"], "properties": { "cmd": { "const": "check_workspace" }, "workspace": { "$ref": "#/$defs/Id" } } },
        { "type": "object", "required": ["cmd", "workspace"], "properties": { "cmd": { "const": "sync_workspace" }, "workspace": { "$ref": "#/$defs/Id" } } },
        { "type": "object", "required": ["cmd", "a", "b"], "properties": { "cmd": { "const": "swap_panes" }, "a": { "$ref": "#/$defs/Id" }, "b": { "$ref": "#/$defs/Id" } } },
        { "type": "object", "required": ["cmd", "pane", "dir", "by"], "properties": { "cmd": { "const": "grow_pane" }, "pane": { "$ref": "#/$defs/Id" }, "dir": { "$ref": "#/$defs/SplitDir" }, "by": { "type": "integer", "minimum": -800, "maximum": 800 } } },
        { "type": "object", "required": ["cmd", "workspace"], "properties": { "cmd": { "const": "list_files" }, "workspace": { "$ref": "#/$defs/Id" }, "path": { "type": "string" } } },
        { "type": "object", "required": ["cmd", "workspace", "query"], "properties": { "cmd": { "const": "find_files" }, "workspace": { "$ref": "#/$defs/Id" }, "query": { "type": "string" } } },
        { "type": "object", "required": ["cmd", "workspace", "name"], "properties": { "cmd": { "const": "rename_workspace" }, "workspace": { "$ref": "#/$defs/Id" }, "name": { "type": "string", "maxLength": 80 } } },
        { "type": "object", "required": ["cmd", "pane", "name"], "properties": { "cmd": { "const": "rename_pane" }, "pane": { "$ref": "#/$defs/Id" }, "name": { "type": "string", "maxLength": 80 } } },
        { "type": "object", "required": ["cmd", "workspace"], "properties": { "cmd": { "const": "new_pane" }, "workspace": { "$ref": "#/$defs/Id" }, "program": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "beside": { "$ref": "#/$defs/Id" }, "dir": { "$ref": "#/$defs/SplitDir" } } },
        { "type": "object", "required": ["cmd", "pane"], "properties": { "cmd": { "const": "close_pane" }, "pane": { "$ref": "#/$defs/Id" } } },
        { "type": "object", "required": ["cmd", "pane", "data"], "properties": { "cmd": { "const": "write" }, "pane": { "$ref": "#/$defs/Id" }, "data": { "type": "string" } } },
        { "type": "object", "required": ["cmd", "pane", "rows", "cols"], "properties": { "cmd": { "const": "resize" }, "pane": { "$ref": "#/$defs/Id" }, "rows": { "type": "integer", "minimum": 1 }, "cols": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "required": ["cmd", "node", "rev"], "properties": { "cmd": { "const": "mark_seen" }, "node": { "$ref": "#/$defs/Id" }, "rev": { "$ref": "#/$defs/Rev" } } },
        {
          "type": "object",
          "required": ["cmd", "workspace", "scope"],
          "properties": { "cmd": { "const": "open_diff" }, "workspace": { "$ref": "#/$defs/Id" }, "scope": { "$ref": "#/$defs/DiffScope" }, "commit": { "$ref": "#/$defs/Sha" } },
          "if": { "properties": { "scope": { "const": "commit" } } },
          "then": { "required": ["commit"] }
        },
        { "type": "object", "required": ["cmd", "workspace"], "properties": { "cmd": { "const": "open_commits" }, "workspace": { "$ref": "#/$defs/Id" } } },
        { "type": "object", "required": ["cmd", "node"], "properties": { "cmd": { "const": "refresh_diff" }, "node": { "$ref": "#/$defs/Id" } } },
        { "type": "object", "required": ["cmd", "node", "path", "viewed"], "properties": { "cmd": { "const": "set_viewed" }, "node": { "$ref": "#/$defs/Id" }, "path": { "type": "string", "minLength": 1 }, "viewed": { "type": "boolean" } } },
        {
          "type": "object",
          "required": ["cmd", "pane", "event"],
          "properties": {
            "cmd": { "const": "agent_event" },
            "pane": { "$ref": "#/$defs/Id" },
            "event": { "$ref": "#/$defs/AgentEvent" },
            "notification_type": { "type": "string" },
            "tool": { "type": "string" }
          }
        },
        { "type": "object", "required": ["cmd"], "properties": { "cmd": { "const": "mobile_start" } } },
        { "type": "object", "required": ["cmd"], "properties": { "cmd": { "const": "mobile_link" } } },
        { "type": "object", "required": ["cmd", "seconds"], "properties": { "cmd": { "const": "mobile_wait" }, "seconds": { "type": "integer", "minimum": 0, "maximum": 300 } } },
        { "type": "object", "required": ["cmd", "yes"], "properties": { "cmd": { "const": "mobile_answer" }, "yes": { "type": "boolean" } } },
        { "type": "object", "required": ["cmd"], "properties": { "cmd": { "const": "mobile_stop" } } }
      ]
    },
    "ClientMsg": {
      "oneOf": [
        {
          "type": "object",
          "required": ["t", "client", "accepts"],
          "properties": {
            "t": { "const": "hello" },
            "client": { "$ref": "#/$defs/Peer" },
            "accepts": { "type": "object", "propertyNames": { "$ref": "#/$defs/NodeType" }, "additionalProperties": { "type": "array", "items": { "type": "integer", "minimum": 1 } } }
          }
        },
        {
          "type": "object",
          "required": ["t", "node"],
          "properties": {
            "t": { "const": "open" },
            "node": { "$ref": "#/$defs/Id" },
            "epoch": { "$ref": "#/$defs/Id" },
            "since": { "$ref": "#/$defs/Rev" }
          }
        },
        { "type": "object", "required": ["t", "node"], "properties": { "t": { "const": "close" }, "node": { "$ref": "#/$defs/Id" } } },
        { "type": "object", "required": ["t", "id", "cmd"], "properties": { "t": { "const": "cmd" }, "id": { "type": "string" }, "cmd": { "$ref": "#/$defs/Cmd" } } }
      ]
    },
    "DaemonMsg": {
      "oneOf": [
        {
          "type": "object",
          "required": ["t", "daemon", "epoch", "root", "accepted"],
          "properties": {
            "t": { "const": "hello" },
            "daemon": { "$ref": "#/$defs/Peer" },
            "epoch": { "$ref": "#/$defs/Id" },
            "root": { "$ref": "#/$defs/Id" },
            "accepted": { "type": "object", "propertyNames": { "$ref": "#/$defs/NodeType" }, "additionalProperties": { "type": "integer", "minimum": 1 } }
          }
        },
        { "type": "object", "required": ["t", "node"], "properties": { "t": { "const": "snapshot" }, "node": { "$ref": "#/$defs/Node" } } },
        {
          "type": "object",
          "required": ["t", "node", "epoch", "from", "to", "ops"],
          "properties": {
            "t": { "const": "patch" },
            "node": { "$ref": "#/$defs/Id" },
            "epoch": { "$ref": "#/$defs/Id" },
            "from": { "$ref": "#/$defs/Rev" },
            "to": { "$ref": "#/$defs/Rev" },
            "ops": { "type": "array", "items": { "$ref": "#/$defs/PatchOp" } }
          }
        },
        { "type": "object", "required": ["t", "node"], "properties": { "t": { "const": "gone" }, "node": { "$ref": "#/$defs/Id" } } },
        {
          "type": "object",
          "required": ["t", "id", "ok"],
          "properties": { "t": { "const": "reply" }, "id": { "type": "string" } },
          "oneOf": [
            { "required": ["ok"], "not": { "required": ["error"] }, "properties": { "ok": { "const": true }, "result": { "type": "object" } } },
            { "required": ["ok", "error"], "properties": { "ok": { "const": false }, "error": { "$ref": "#/$defs/ErrorBody" } } }
          ]
        },
        {
          "type": "object",
          "required": ["t", "code", "message"],
          "properties": { "t": { "const": "error" }, "code": { "$ref": "#/$defs/ErrorCode" }, "message": { "type": "string" } }
        }
      ]
    },
    "ErrorBody": {
      "type": "object",
      "required": ["code", "message"],
      "properties": { "code": { "$ref": "#/$defs/ErrorCode" }, "message": { "type": "string" } }
    },
    "Denied": {
      "description": "Why the bridge refused a phone: the pairing token was wrong, expired or spent; the person at the PC said no or did not answer; the device secret is unknown or revoked; too many failures from this address.",
      "enum": ["bad_token", "declined", "timeout", "bad_secret", "revoked", "locked_out"]
    },
    "PhoneMsg": {
      "description": "What a phone sends the bridge before the daemon's protocol starts: it either spends a pairing token or proves a paired device. After `ready` the stream carries ClientMsg.",
      "oneOf": [
        {
          "type": "object",
          "required": ["t", "token", "name", "code"],
          "properties": {
            "t": { "const": "pair" },
            "token": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "code": { "type": "string", "pattern": "^[0-9]{4,12}$" }
          }
        },
        {
          "type": "object",
          "required": ["t", "device", "secret"],
          "properties": {
            "t": { "const": "auth" },
            "device": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
            "secret": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "BridgeMsg": {
      "description": "What the bridge sends a phone: the answer to pair or auth, then (after `ready`) the addresses the PC can be reached at. After `ready` the stream also carries DaemonMsg.",
      "oneOf": [
        {
          "type": "object",
          "required": ["t", "device", "secret"],
          "properties": {
            "t": { "const": "paired" },
            "device": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
            "secret": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "required": ["t", "reason"],
          "properties": { "t": { "const": "denied" }, "reason": { "$ref": "#/$defs/Denied" } }
        },
        { "type": "object", "required": ["t"], "properties": { "t": { "const": "ready" }, "host": { "type": "string", "minLength": 1, "maxLength": 64 } } },
        {
          "type": "object",
          "required": ["t"],
          "properties": {
            "t": { "const": "endpoints" },
            "lan": { "type": "string", "description": "host:port of the TLS listener on the PC's private address" },
            "tunnel": { "type": "string", "description": "host name of the Cloudflare tunnel" }
          }
        }
      ]
    }
  }
}
